# ============================================
#   API Credentials (REQUIRED)
# ============================================
# Get these from your   account manager
 _CLIENT_ID=your-client-id-here
 _CLIENT_SECRET=your-client-secret-here

# ============================================
#   API Endpoints (REQUIRED)
# ============================================
# API base URL
 _API_URL=https://platform. .com/api

# OAuth base URL (provided by  )
# Note: Do NOT include /v1/token - the backend appends this automatically
 _AUTH_URL=your-oauth-base-url-here

# ============================================
# Application Configuration
# ============================================
# Frontend URL for CORS (Cross-Origin Resource Sharing)
# For local development: http://localhost:5173
# For production: Set to your deployed frontend URL (e.g., https://yourdomain.com)
FRONTEND_URL=http://localhost:5173

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your   credentials:
#    -  _CLIENT_ID
#    -  _CLIENT_SECRET
#    -  _AUTH_URL (OAuth token URL provided by  )
# 3. Save and start the backend: uvicorn api.main:app --reload
#
# SECURITY: Never commit .env to git!
